# CloudMind AI Configuration Example
# Copy this file to .env and update with your credentials

# Application Settings
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# AWS Configuration
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Azure Configuration
AZURE_ENABLED=false
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# Google Cloud Configuration
GCP_ENABLED=false
GCP_PROJECT_ID=your_gcp_project_id
GCP_CREDENTIALS_PATH=/path/to/gcp-credentials.json

# On-Premises Configuration
ONPREM_ENABLED=false
ONPREM_HOSTS=host1.example.com,host2.example.com

# AI/ML Configuration
AI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Monitoring Configuration
MONITORING_INTERVAL=300
ALERT_THRESHOLD_CPU=80.0
ALERT_THRESHOLD_MEMORY=80.0
ALERT_THRESHOLD_COST=1000.0

# Optimization Configuration
AUTO_OPTIMIZE=false
OPTIMIZATION_INTERVAL=3600
